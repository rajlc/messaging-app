# =============================================================================
# .env.example — Copy this to .env.local and fill in your actual values.
# This file is SAFE to commit to GitHub (no real secrets here).
# =============================================================================

# Order / Messaging Supabase Project
NEXT_PUBLIC_SUPABASE_URL=https://your-order-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-order-anon-key

# Inventory Supabase Project (public)
NEXT_PUBLIC_INV_SUPABASE_URL=https://your-inventory-project.supabase.co
NEXT_PUBLIC_INV_SUPABASE_ANON_KEY=your-inventory-anon-key

# Inventory Supabase Service-Role Key (SECRET — server-side only, never in browser)
INV_SUPABASE_SERVICE_ROLE_KEY=your-inventory-service-role-key

# API / WebSocket URLs
NEXT_PUBLIC_API_URL=http://localhost:3002
NEXT_PUBLIC_WS_URL=http://localhost:3002
