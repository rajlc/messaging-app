# =============================================================================
# .env.example — Copy this to .env and fill in your actual values.
# This file is SAFE to commit to GitHub (no real secrets here).
# =============================================================================

# Database Configuration (local or Supabase direct connection)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_NAME=messaging_app
SUPABASE_DB_PASSWORD=your-supabase-db-password

# Meta / Facebook API
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_VERIFY_TOKEN=your-webhook-verify-token
META_PAGE_ACCESS_TOKEN=your-page-access-token
META_PAGE_ID=your-page-id

# TikTok API
TIKTOK_BUSINESS_ID=
TIKTOK_ACCESS_TOKEN=

# Inventory App
INV_APP_URL=http://localhost:3000
INV_APP_API_KEY=your-inventory-api-key

# App Configuration
PORT=3002
JWT_SECRET=your-jwt-secret-min-32-chars

# Supabase (Order/Messaging Project)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
INVENTORY_APP_API_KEY=your-inventory-api-key

# Logistics Webhooks
PATHAO_WEBHOOK_SECRET=your-pathao-webhook-secret
PICKDROP_WEBHOOK_SECRET=your-pickdrop-webhook-secret

# Ecommerce App
ECOMMERCE_APP_URL=http://localhost:3000
